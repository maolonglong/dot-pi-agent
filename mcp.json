{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth",
      "exposure": "direct"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp?login&tools=web_search_exa,web_fetch_exa",
      "exposure": "codemode",
      "toolExposure": {
        "web_search_exa": "direct"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {
        "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org/"
      },
      "exposure": "deferred"
    }
  }
}
